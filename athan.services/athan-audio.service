[Unit]
Description=Continuous Athan PCM audio service
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=qais
WorkingDirectory=/home/qais/piAthan
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=HOME=/home/qais
Environment=ATHAN_AUDIO_SINK_NAME=Echo Dot-2CW
ExecStart=/usr/bin/python3 /home/qais/piAthan/src/athan_audio.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
